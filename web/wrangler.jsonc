{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suriwiki",
  "compatibility_date": "2026-09-01",

  // suriwiki.com이 정상 동작하는 것을 확인했으므로 workers.dev를 끈다.
  // 같은 콘텐츠가 apex와 workers.dev 양쪽에서 서비스되면 중복 콘텐츠가 되어
  // SEO에 불리하다(이 사이트는 검색 노출이 존재 이유다).
  //
  // 명시적으로 false를 적어두는 이유: 이 값을 생략하면 wrangler가 routes 유무에
  // 따라 알아서 켜고 끄는데, 그 암묵적 동작 때문에 과거 배포에서 커스텀 도메인
  // 실패와 겹쳐 사이트가 통째로 404가 된 적이 있다. 의도를 파일에 남겨둔다.
  "workers_dev": false,

  // 커스텀 도메인. custom_domain:true면 Worker 자체가 오리진이 되고
  // Cloudflare가 DNS 레코드와 인증서를 자동 생성·관리한다.
  //
  // 선행 조건(2026-09-01 완료): custom_domain은 기존 DNS 레코드를 자동으로
  // 덮어쓰지 않는다(실수 방지). Vercel을 가리키던 apex CNAME이 남아 있는 동안은
  // "already has externally managed DNS records [code: 100117]"로 배포가 거부됐고,
  // 해당 레코드를 수동 삭제한 뒤에야 연결이 가능해졌다.
  //
  // www.suriwiki.com은 여기 넣지 않는다 — 같은 Worker에 두 호스트명을 붙이면
  // 동일 콘텐츠가 두 주소로 색인돼 중복 콘텐츠가 된다. www는 Redirect Rule로
  // apex에 301 보낸다 (docs/DEPLOY.md 참고).
  "routes": [
    {
      "pattern": "suriwiki.com",
      "custom_domain": true
    }
  ],

  // 정적 자산만 배포하는 Worker다. Worker 스크립트(main)가 없으므로
  // assets.binding("ASSETS")도 두지 않는다 — main이 있을 때만 유효한 필드.
  "assets": {
    // next build --output:'export'의 결과물
    "directory": "./out/",

    // Pages는 404.html/index.html을 보고 SPA인지 정적 사이트인지 알아서 추측했지만,
    // Workers는 오설정을 막으려고 이걸 명시하게 한다.
    // 우리는 SSG라 매칭 안 되는 경로에 Next가 만든 404.html을 돌려준다.
    "not_found_handling": "404-page",

    // /foo → /foo.html 매핑 + 후행 슬래시 정규화
    "html_handling": "auto-trailing-slash"
  }
}
