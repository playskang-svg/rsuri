{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suriwiki",
  "compatibility_date": "2026-09-01",

  // routes를 선언하면 wrangler가 workers.dev를 기본으로 꺼버린다(실제로 겪음 —
  // 사이트가 404가 됐다). 커스텀 도메인이 살아날 때까지는 이 주소가 유일한
  // 접속 경로이므로 명시적으로 켜둔다.
  //
  // TODO: suriwiki.com이 정상 동작하면 false로 되돌린다. 같은 콘텐츠가
  //       workers.dev와 apex 양쪽에 노출되면 중복 콘텐츠가 되어 SEO에 불리하다.
  "workers_dev": true,

  // ── 커스텀 도메인 (현재 비활성 — 선행 작업 필요) ───────────────────────
  //
  // 아래를 켜면 배포가 실패한다. Cloudflare가 거부하기 때문:
  //   Hostname 'suriwiki.com' already has externally managed DNS records
  //   (A, CNAME, etc). Delete them first. [code: 100117]
  //
  // custom_domain은 기존 DNS 레코드를 자동으로 덮어쓰지 않는다(실수 방지 장치).
  // suriwiki.com에는 아직 Vercel을 가리키는 A 레코드가 남아 있다.
  //
  // 선행 작업: Cloudflare DNS > Records에서 suriwiki.com의 A 레코드
  //   (64.29.17.65 / 216.198.79.65 — Vercel)를 삭제한다.
  //   ⚠️ 삭제하는 순간 이 도메인의 기존 Vercel 사이트는 내려간다.
  //
  // 그 뒤 아래 주석을 해제하고 배포하면 Cloudflare가 DNS와 인증서를 자동 생성한다.
  // 동시에 위 workers_dev를 false로 바꿔 중복 콘텐츠를 막는다.
  //
  // www.suriwiki.com은 여기 넣지 않는다 — 같은 Worker에 두 호스트명을 붙이면
  // 동일 콘텐츠가 두 주소로 색인된다. www는 Redirect Rule로 apex에 301 보낸다
  // (docs/DEPLOY.md 참고).
  //
  // "routes": [
  //   {
  //     "pattern": "suriwiki.com",
  //     "custom_domain": true
  //   }
  // ],

  // 정적 자산만 배포하는 Worker다. Worker 스크립트(main)가 없으므로
  // assets.binding("ASSETS")도 두지 않는다 — main이 있을 때만 유효한 필드.
  "assets": {
    // next build --output:'export'의 결과물
    "directory": "./out/",

    // Pages는 404.html/index.html을 보고 SPA인지 정적 사이트인지 알아서 추측했지만,
    // Workers는 오설정을 막으려고 이걸 명시하게 한다.
    // 우리는 SSG라 매칭 안 되는 경로에 Next가 만든 404.html을 돌려준다.
    "not_found_handling": "404-page",

    // /foo → /foo.html 매핑 + 후행 슬래시 정규화
    "html_handling": "auto-trailing-slash"
  }
}
