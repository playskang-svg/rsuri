{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suriwiki",
  "compatibility_date": "2026-09-01",

  // 커스텀 도메인. custom_domain:true면 Worker 자체가 오리진이 되고
  // Cloudflare가 DNS 레코드와 인증서를 자동으로 관리한다(수동 DNS 작업 불필요).
  //
  // ⚠️ 이 배포는 suriwiki.com의 기존 A 레코드(Vercel)를 교체한다 —
  //    이전에 이 도메인에서 서비스되던 Vercel 사이트는 더 이상 노출되지 않는다.
  //
  // www.suriwiki.com은 일부러 여기 넣지 않았다. 같은 Worker에 두 호스트명을
  // 붙이면 동일 콘텐츠가 두 주소로 색인돼 중복 콘텐츠가 된다. www는
  // Cloudflare Redirect Rule로 apex에 301 리다이렉트시킨다 — docs/DEPLOY.md 참고.
  "routes": [
    {
      "pattern": "suriwiki.com",
      "custom_domain": true
    }
  ],

  // 정적 자산만 배포하는 Worker다. Worker 스크립트(main)가 없으므로
  // assets.binding("ASSETS")도 두지 않는다 — main이 있을 때만 유효한 필드.
  "assets": {
    // next build --output:'export'의 결과물
    "directory": "./out/",

    // Pages는 404.html/index.html을 보고 SPA인지 정적 사이트인지 알아서 추측했지만,
    // Workers는 오설정을 막으려고 이걸 명시하게 한다.
    // 우리는 SSG라 매칭 안 되는 경로에 Next가 만든 404.html을 돌려준다.
    "not_found_handling": "404-page",

    // /foo → /foo.html 매핑 + 후행 슬래시 정규화
    "html_handling": "auto-trailing-slash"
  }
}
