{
  "name": "bizhelp-admin",
  "main": "worker/admin.mjs",
  "compatibility_date": "2026-10-01",
  // 정적 리포트는 ASSETS가 직접 서빙하고, /upload/* 와 /api/* 만 워커가 처리한다.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/upload/*"] },
  // D1(정보·메타데이터·메모), R2(파일). ID를 적지 않으면 wrangler가 배포 때 자동으로 만든다(자동 프로비저닝).
  "d1_databases": [{ "binding": "DB", "database_name": "bizhelp-admin" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bizhelp-admin-files" }],
  // 커스텀 도메인: 배포 때 DNS 레코드와 인증서를 Cloudflare가 자동으로 만든다(DNS 편집 권한 불필요).
  // 와일드카드 라우트/DNS는 쓰지 않는다 — 기존 서브도메인(battery 등)을 가로채기 때문이다.
  "routes": [{ "pattern": "admin.suriwiki.com", "custom_domain": true }]
}
