{
  "name": "bizhelp-admin",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  // 관리자는 와일드카드 서브도메인 워커(*.suriwiki.com/*)보다 구체적인 라우트로 붙인다(구체적인 패턴이 우선).
  // DNS는 와일드카드 `*` AAAA 100:: (프록시) 한 줄이 커버한다.
  "routes": [{ "pattern": "admin.suriwiki.com/*", "zone_name": "suriwiki.com" }]
}
